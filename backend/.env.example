# Copy this file to .env (same folder) and fill in your own values.
# Never commit the real .env file.

# Required: Google Gemini key used by the claim-extraction agents
GEMINI_API_KEY=your_gemini_key_here

# Optional but recommended: free key from semanticscholar.org/product/api
# Removes most rate-limit (429) waits and finds more papers.
SEMANTIC_SCHOLAR_API_KEY=
# Optional: extra frontend addresses allowed to call the API (comma separated)
CORS_ORIGINS=
